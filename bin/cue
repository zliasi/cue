#!/usr/bin/env python3
"""
cue, run a program on many inputs as one Slurm array job.

Usage:
  cue TEMPLATE [OPTIONS] INPUT...
  cue list | show TEMPLATE | init TEMPLATE | completion

Settings merge in this order, later wins: CUE_HOME/cue.conf, the user's
~/.config/cue/cue.conf, the #CUE header of the template, command-line
flags. Templates are looked up in ~/.config/cue/templates first and then
in CUE_HOME/templates. CUE_HOME defaults to the directory above this file.

Exit status 0 on success, 1 on a user error, 2 when Slurm rejects the job.
Python 3.9 standard library only, so it runs on every login node.
"""

from __future__ import annotations

import argparse
import fcntl
import os
import re
import shutil
import subprocess
import sys
import time
from collections.abc import Iterator, Sequence
from contextlib import contextmanager
from dataclasses import dataclass
from pathlib import Path
from typing import NoReturn

EXIT_OK = 0
EXIT_USER = 1
EXIT_SLURM = 2

COMMANDS = ("list", "show", "init", "completion")
TEMPLATE_SUFFIX = ".sbatch"
HEADER_PREFIX = "#CUE "
PLACEHOLDER_PATTERN = re.compile(r"\{\{([a-z][a-z0-9_]*)\}\}")
STAMP_FORMAT = "%Y%m%d-%H%M%S"
LOCK_NAME = ".lock"
LOCK_ATTEMPTS = 30
LOCK_WAIT_SECONDS = 1.0
SBATCH_TIMEOUT_SECONDS = 120
JOB_ID_PATTERN = re.compile(r"^\d+(:\d+)*$")
KEY_PATTERN = re.compile(r"^[a-z][a-z0-9_]*$")
NAME_PATTERN = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
TIME_PATTERN = re.compile(r"^(\d+-)?\d+(:\d+){0,2}$")
POSITIVE_INT_KEYS = ("cpus", "memory", "throttle", "ntasks")


class UserError(Exception):
    """A problem the user can fix, reported once and exit 1."""


class SlurmError(Exception):
    """A rejected or failed sbatch call, reported once and exit 2."""


class Parser(argparse.ArgumentParser):
    """ArgumentParser whose usage errors exit 1 like every other user error."""

    def error(self, message: str) -> NoReturn:
        raise UserError(message)


@dataclass(frozen=True)
class SubmitRequest:
    """
    Validated submit arguments. Only flags the user gave are in flags.

    Inputs come from the command line or from the manifest file, never both.
    """

    template: str
    inputs: tuple[str, ...]
    manifest: str | None
    skip_done: bool
    dry_run: bool
    after: str | None
    flags: dict[str, str]


@dataclass(frozen=True)
class Submission:
    """A rendered job ready for sbatch, paths relative to the working dir."""

    template: str
    name: str
    stamp: str
    inputs: tuple[str, ...]
    script: str
    manifest: Path
    outdir: Path
    logdir: Path


def cue_home() -> Path:
    """Return CUE_HOME, or the checkout holding this script when unset."""
    env = os.environ.get("CUE_HOME")
    if env:
        return Path(env)
    return Path(__file__).resolve().parent.parent


def user_dir() -> Path:
    """Return the per-user config directory, XDG_CONFIG_HOME aware."""
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "cue"


def template_dirs() -> list[Path]:
    """Return template directories in lookup order, user first."""
    return [user_dir() / "templates", cue_home() / "templates"]


def check_template_name(name: str) -> None:
    """Reject names that could escape the template directories."""
    if not NAME_PATTERN.match(name):
        raise UserError(f"invalid template name: {name}")


def find_template(name: str) -> Path:
    """Return the first template file called NAME, user dir shadows shipped."""
    check_template_name(name)
    for directory in template_dirs():
        candidate = directory / (name + TEMPLATE_SUFFIX)
        if candidate.is_file():
            return candidate
    searched = ", ".join(str(d) for d in template_dirs())
    raise UserError(f"no template {name}{TEMPLATE_SUFFIX} in {searched}")


def list_templates() -> list[tuple[str, Path]]:
    """Return (name, path) for every visible template, sorted by name."""
    seen: dict[str, Path] = {}
    for directory in template_dirs():
        if not directory.is_dir():
            continue
        for path in sorted(directory.glob("*" + TEMPLATE_SUFFIX)):
            seen.setdefault(path.name[: -len(TEMPLATE_SUFFIX)], path)
    return sorted(seen.items())


def parse_assignment(text: str, where: str) -> tuple[str, str]:
    """Split KEY=VALUE, lowercase key of letters, digits, and underscores."""
    key, sep, value = text.partition("=")
    if not sep or not KEY_PATTERN.match(key):
        raise UserError(f"{where}: expected KEY=VALUE, got {text!r}")
    return key, value.strip()


def read_conf(path: Path) -> dict[str, str]:
    """Read KEY=VALUE lines from PATH, blank lines and # comments ignored."""
    values: dict[str, str] = {}
    if not path.is_file():
        return values
    with path.open(encoding="utf-8") as handle:
        for number, raw in enumerate(handle, start=1):
            line = raw.strip()
            if not line or line.startswith("#"):
                continue
            key, value = parse_assignment(line, f"{path}:{number}")
            values[key] = value
    return values


def read_header(path: Path) -> dict[str, str]:
    """Read KEY=VALUE tokens from the #CUE lines at the top of a template."""
    values: dict[str, str] = {}
    with path.open(encoding="utf-8") as handle:
        for number, raw in enumerate(handle, start=1):
            if not raw.startswith(HEADER_PREFIX):
                continue
            for token in raw[len(HEADER_PREFIX) :].split():
                key, value = parse_assignment(token, f"{path}:{number}")
                values[key] = value
    return values


def validate_settings(settings: dict[str, str]) -> None:
    """Check the values cue itself relies on, other keys pass through."""
    for key in POSITIVE_INT_KEYS:
        value = settings.get(key)
        if value is not None and not (value.isdigit() and int(value) > 0):
            raise UserError(f"{key} must be a positive integer, got {value!r}")
    time = settings.get("time")
    if time is not None and not TIME_PATTERN.match(time):
        raise UserError(f"time must look like D-HH:MM:SS or HH:MM:SS, got {time!r}")


def resolve_settings(template: Path, flags: dict[str, str]) -> dict[str, str]:
    """Merge site conf, user conf, template header, and flags, later wins."""
    settings: dict[str, str] = {}
    settings.update(read_conf(cue_home() / "cue.conf"))
    settings.update(read_conf(user_dir() / "cue.conf"))
    settings.update(read_header(template))
    settings.update(flags)
    validate_settings(settings)
    return settings


def render(text: str, values: dict[str, str]) -> str:
    """Replace every {{key}} in TEXT, fail on keys missing from VALUES."""
    missing = sorted(
        {m.group(1) for m in PLACEHOLDER_PATTERN.finditer(text)} - set(values)
    )
    if missing:
        raise UserError(
            "no value for " + ", ".join(missing) + ", set it in cue.conf or with --set"
        )
    return PLACEHOLDER_PATTERN.sub(lambda m: values[m.group(1)], text)


def strip_header(text: str) -> str:
    """Drop the #CUE lines, they hold defaults and are not part of the job."""
    kept = [
        line for line in text.splitlines(True) if not line.startswith(HEADER_PREFIX)
    ]
    return "".join(kept)


def read_manifest(path: Path) -> list[str]:
    """Read one input per line, blank lines and # comments ignored."""
    if not path.is_file():
        raise UserError(f"no manifest file {path}")
    lines = [line.strip() for line in path.read_text(encoding="utf-8").splitlines()]
    inputs = [line for line in lines if line and not line.startswith("#")]
    if not inputs:
        raise UserError(f"manifest {path} has no inputs")
    return inputs


def validate_inputs(inputs: Sequence[str], ext: str | None) -> None:
    """Every input must be an existing file with the template extension."""
    for item in inputs:
        if ext and not item.endswith(ext):
            raise UserError(f"{item} does not end with {ext}")
        if not Path(item).is_file():
            raise UserError(f"input not found: {item}")


def stem_of(item: str) -> str:
    """Return the basename without its last extension, as cue.sh does."""
    name = Path(item).name
    return name.rsplit(".", 1)[0] if "." in name else name


def done_path(pattern: str, item: str, outdir: str) -> Path:
    """Render the done pattern for ITEM, relative paths live under OUTDIR."""
    values = {"stem": stem_of(item), "input": item, "outdir": outdir}
    path = Path(render(pattern, values))
    return path if path.is_absolute() else Path(outdir) / path


def drop_done(inputs: Sequence[str], settings: dict[str, str]) -> list[str]:
    """Return the inputs whose done file is missing, needs done and outdir."""
    pattern = settings.get("done")
    if not pattern:
        raise UserError("--skip-done needs a done pattern in the template header")
    outdir = require(settings, "outdir", "-o")
    return [i for i in inputs if not done_path(pattern, i, outdir).exists()]


def require(settings: dict[str, str], key: str, flag: str) -> str:
    """Return SETTINGS[KEY] or fail naming the flag that sets it."""
    value = settings.get(key)
    if not value:
        raise UserError(f"{key} is not set, add it to cue.conf or use {flag}")
    return value


def cmd_list() -> int:
    """Print every template with the directory it comes from."""
    for name, path in list_templates():
        print(f"{name:16} {path.parent}")
    return EXIT_OK


def cmd_show(name: str) -> int:
    """Print the template that NAME resolves to."""
    sys.stdout.write(find_template(name).read_text(encoding="utf-8"))
    return EXIT_OK


def cmd_init(name: str) -> int:
    """Copy the shipped template NAME into the user template directory."""
    check_template_name(name)
    source = cue_home() / "templates" / (name + TEMPLATE_SUFFIX)
    if not source.is_file():
        raise UserError(f"no shipped template {name}, see cue list")
    target = user_dir() / "templates" / source.name
    if target.exists():
        raise UserError(f"{target} exists, remove it first")
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source, target)
    print(target)
    return EXIT_OK


def cmd_completion() -> int:
    """Print the bash completion file shipped with cue."""
    path = cue_home() / "completions" / "cue"
    if not path.is_file():
        raise UserError(f"no completion file at {path}")
    sys.stdout.write(path.read_text(encoding="utf-8"))
    return EXIT_OK


def collect_inputs(request: SubmitRequest, settings: dict[str, str]) -> list[str]:
    """Gather, validate, and filter the inputs of a submission."""
    if request.manifest is not None:
        inputs = read_manifest(Path(request.manifest))
    else:
        inputs = list(request.inputs)
    validate_inputs(inputs, settings.get("ext"))
    if request.skip_done:
        kept = drop_done(inputs, settings)
        print(f"cue: skipping {len(inputs) - len(kept)} done inputs", file=sys.stderr)
        if not kept:
            raise UserError("every input is done, nothing to submit")
        inputs = kept
    return inputs


def prepare_submission(
    request: SubmitRequest, template: Path, settings: dict[str, str], stamp: str
) -> Submission:
    """Collect inputs and render the job script for REQUEST."""
    inputs = collect_inputs(request, settings)
    name = settings.get("name") or template.name[: -len(TEMPLATE_SUFFIX)]
    outdir = Path(require(settings, "outdir", "-o"))
    logdir = Path(require(settings, "logdir", "-l"))
    manifest = logdir / f"{name}-{stamp}.manifest"
    values = dict(settings)
    values.update(
        name=name,
        last=str(len(inputs) - 1),
        manifest=str(manifest),
        cue_lib=str(cue_home() / "lib" / "cue.sh"),
    )
    text = strip_header(template.read_text(encoding="utf-8"))
    script = render(text, values)
    return Submission(
        request.template, name, stamp, tuple(inputs), script, manifest, outdir, logdir
    )


def run_sbatch(args: Sequence[str], script: str | None = None) -> str:
    """Run sbatch with ARGS, SCRIPT on stdin when given, return its stdout."""
    # A script file on the command line leaves stdin unused, so close it.
    stdin = None if script is not None else subprocess.DEVNULL
    try:
        done = subprocess.run(
            ["sbatch", *args],
            input=script,
            stdin=stdin,
            capture_output=True,
            text=True,
            timeout=SBATCH_TIMEOUT_SECONDS,
            check=False,
        )
    except FileNotFoundError as error:
        raise SlurmError("sbatch not found, is this a login node?") from error
    except subprocess.TimeoutExpired as error:
        raise SlurmError(
            f"sbatch gave no answer in {SBATCH_TIMEOUT_SECONDS}s"
        ) from error
    if done.returncode != 0:
        raise SlurmError(done.stderr.strip() or f"sbatch exited {done.returncode}")
    sys.stderr.write(done.stderr)
    return done.stdout.strip()


@contextmanager
def locked(logdir: Path) -> Iterator[None]:
    """Hold logdir/.lock so two cue runs never back up or submit at once."""
    with (logdir / LOCK_NAME).open("w") as handle:
        for attempt in range(LOCK_ATTEMPTS):
            try:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
                break
            except BlockingIOError:
                if attempt == LOCK_ATTEMPTS - 1:
                    raise UserError(
                        f"{logdir / LOCK_NAME} is held by another cue"
                    ) from None
                time.sleep(LOCK_WAIT_SECONDS)
        try:
            yield
        finally:
            fcntl.flock(handle, fcntl.LOCK_UN)


def backup_outputs(sub: Submission) -> list[tuple[Path, Path]]:
    """Move out/<stem>.* of every input to out/backup/<stamp>/, return moves."""
    target = sub.outdir / "backup" / sub.stamp
    moves: list[tuple[Path, Path]] = []
    for item in sub.inputs:
        for path in sorted(sub.outdir.glob(stem_of(item) + ".*")):
            if path.is_file():
                moves.append((path, target / path.name))
    if moves:
        target.mkdir(parents=True, exist_ok=True)
        for source, destination in moves:
            source.replace(destination)
        print(f"cue: moved {len(moves)} old output files to {target}", file=sys.stderr)
    return moves


def restore_outputs(moves: Sequence[tuple[Path, Path]]) -> None:
    """Undo backup_outputs after a failed submission."""
    for source, destination in moves:
        destination.replace(source)


def write_record(sub: Submission, request: SubmitRequest, job_id: str) -> Path:
    """Write log/<name>-<jobid>.cue with what cue -f needs to resubmit."""
    path = sub.logdir / f"{sub.name}-{job_id}.cue"
    lines = [
        f"# resubmit with: cue -f {path}",
        f"template={sub.template}",
        f"manifest={sub.manifest}",
        f"job={job_id}",
        f"stamp={sub.stamp}",
    ]
    if request.skip_done:
        lines.append("skip_done=1")
    lines.extend(f"{key}={value}" for key, value in sorted(request.flags.items()))
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")
    return path


def submit(sub: Submission, request: SubmitRequest) -> str:
    """Back up, write manifest and script, call sbatch, return the job id."""
    args = ["--parsable", f"--comment=cue:{sub.name}"]
    if request.after is not None:
        args.append(f"--dependency=afterok:{request.after}")
    sub.outdir.mkdir(parents=True, exist_ok=True)
    sub.logdir.mkdir(parents=True, exist_ok=True)
    with locked(sub.logdir):
        moves = backup_outputs(sub)
        sub.manifest.write_text("\n".join(sub.inputs) + "\n", encoding="utf-8")
        script = sub.manifest.with_suffix(".sbatch")
        script.write_text(sub.script, encoding="utf-8")
        try:
            job_id = run_sbatch([*args, str(script)]).partition(";")[0]
        except SlurmError:
            restore_outputs(moves)
            raise
        write_record(sub, request, job_id)
    return job_id


def cmd_submit(request: SubmitRequest) -> int:
    """Render and submit, or with --dry-run print the script and test it."""
    template = find_template(request.template)
    settings = resolve_settings(template, request.flags)
    sub = prepare_submission(request, template, settings, time.strftime(STAMP_FORMAT))
    if request.dry_run:
        sys.stdout.write(sub.script)
        run_sbatch(["--test-only"], sub.script)
        return EXIT_OK
    print(submit(sub, request))
    return EXIT_OK


USAGE = """\
cue TEMPLATE [OPTIONS] INPUT...
       cue TEMPLATE [OPTIONS] -M MANIFEST
       cue list | show TEMPLATE | init TEMPLATE | completion"""


def submit_parser() -> argparse.ArgumentParser:
    """Build the parser for a submission."""
    parser = Parser(
        prog="cue",
        usage=USAGE,
        description="run a program on many inputs as one Slurm array job",
    )
    parser.add_argument("template")
    parser.add_argument("inputs", nargs="*", metavar="INPUT")
    parser.add_argument("-M", "--manifest", help="file with one input per line")
    parser.add_argument("-c", "--cpus", help="cores per task")
    parser.add_argument("-m", "--memory", help="memory per task in GB")
    parser.add_argument("-t", "--time", help="time limit, D-HH:MM:SS")
    parser.add_argument("-p", "--partition", help="partition")
    parser.add_argument("-T", "--throttle", help="tasks running at once")
    parser.add_argument(
        "--skip-done", action="store_true", help="drop inputs whose done file exists"
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print the script, run sbatch --test-only",
    )
    parser.add_argument("--after", metavar="JOBID", help="start after JOBID succeeds")
    return parser


def command_parser(command: str) -> argparse.ArgumentParser:
    """Build the parser for list, show, init, or completion."""
    helps = {
        "list": "list templates and where they come from",
        "show": "print a template",
        "init": "copy a template to your own directory",
        "completion": "print the bash completion file",
    }
    parser = Parser(prog=f"cue {command}", description=helps[command])
    if command in ("show", "init"):
        parser.add_argument("template")
    return parser


def submit_request(args: argparse.Namespace) -> SubmitRequest:
    """Turn parsed submit arguments into a request, dropping unset flags."""
    flags: dict[str, str] = {}
    for key in ("cpus", "memory", "time", "partition", "throttle"):
        value = getattr(args, key)
        if value is not None:
            flags[key] = str(value)
    inputs = tuple(str(i) for i in args.inputs)
    manifest = None if args.manifest is None else str(args.manifest)
    if bool(inputs) == (manifest is not None):
        raise UserError("give input files or -M MANIFEST, one of the two")
    after = None if args.after is None else str(args.after)
    if after is not None and not JOB_ID_PATTERN.match(after):
        raise UserError(f"--after expects a job id, got {after!r}")
    return SubmitRequest(
        str(args.template),
        inputs,
        manifest,
        bool(args.skip_done),
        bool(args.dry_run),
        after,
        flags,
    )


def dispatch(argv: Sequence[str]) -> int:
    """Parse ARGV and run the selected command."""
    words = list(argv)
    if not words:
        print(f"usage: {USAGE}", file=sys.stderr)
        return EXIT_USER
    command = words[0] if words[0] in COMMANDS else "submit"
    if command == "submit":
        # Intermixed parsing lets options follow the input list on 3.9.
        args = submit_parser().parse_intermixed_args(words)
        return cmd_submit(submit_request(args))
    args = command_parser(command).parse_args(words[1:])
    if command == "list":
        return cmd_list()
    if command == "show":
        return cmd_show(str(args.template))
    if command == "init":
        return cmd_init(str(args.template))
    return cmd_completion()


def main(argv: Sequence[str] | None = None) -> int:
    """Run cue, report one error line on failure, and return the status."""
    try:
        return dispatch(sys.argv[1:] if argv is None else argv)
    except UserError as error:
        print(f"cue: {error}", file=sys.stderr)
        return EXIT_USER
    except SlurmError as error:
        print(f"cue: {error}", file=sys.stderr)
        return EXIT_SLURM


if __name__ == "__main__":
    sys.exit(main())
